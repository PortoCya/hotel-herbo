{
  "expo": {
    "name": "Hotel Herbo",
    "slug": "hotel-herbo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a1a12",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10261b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para anexar imagens às suas solicitações no Hotel Herbo.",
          "cameraPermission": "Permita o acesso à câmera para fotografar itens ou solicitações no Hotel Herbo."
        }
      ]
    ]
  }
}

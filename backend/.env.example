# Copie este arquivo para ".env" e ajuste os valores.
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-bem-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL local
DB_ENGINE=postgres
DB_NAME=hotel_herbo
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Use DB_ENGINE=sqlite apenas para um teste rápido sem PostgreSQL.

# Opcional: se definido, usa Redis como channel layer (ex.: redis://127.0.0.1:6379/0)
REDIS_URL=
